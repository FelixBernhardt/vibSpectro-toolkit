#!/usr/bin/env python

#
# generate cells along eigenmodes
# (run calculations separately for all cells)
# read in data from phonopy
# calculate resonant Raman intensity for various modes
# i.e. two dielectric functions per mode
#

import sys
import datetime
from numpy import arange, empty, dot, array
from numpy.linalg import inv
from spglib import get_symmetry_dataset
from RamanLib import periodTable, removeModes
from symmetries import analysis
from parserPhonopy import parsePhonopy
from displace import displace
from calcTensors import calcTensors
from calcSpectrum import calcSpectrum
from plotSpectrum import plotSpectrum
from IR import calcIR

sys.dont_write_bytecode = True

if __name__ == '__main__':

    print("")
    print("  _____                             _____       ")     
    print(" |  __ \                           |  __ \      ")     
    print(" | |__) |__ _ _ __ ___   __ _ _ __ | |__) |   _ ")
    print(" |  _  // _` | '_ ` _ \ / _` | '_ \|  ___/ | | |")
    print(" | | \ \ (_| | | | | | | (_| | | | | |   | |_| |")
    print(" |_|  \_\__,_|_| |_| |_|\__,_|_| |_|_|    \__, |")
    print("                                           __/ |")
    print("                                          |___/ ")
    print("")
    print("")
    print("    Started at: "+datetime.datetime.now().strftime("%Y-%m-%d %H:%M"))
    print("")
    
    #
    from parserArgs import args
    disps = [-1, 1]
    version = "0.0.1"

    if args.version == True:
        print("[__main__]: Version "+version)
        sys.exit(1)
    #

    if args.analysis == True:
        print("[__main__]: Analyzing symmetries")
        analysis()
        sys.exit(1)
    #

    ###################################
    #
    # setup which modes to calculate
    if args.modelist == None :
        eigvals, eigvecs, norms, qpoint, basis, nat, elements, positions, masses, = parsePhonopy(None, None)
        args.modelist = arange(1, 3*nat+1, 1)
    else:
        # check the modes
        modelist = []
        for j in args.modelist.split():
            if j.isdigit() == True:
                modelist.append(int(j))
            elif j.split("-")[0].isdigit() == True and j.split("-")[-1].isdigit() == True:
                if int(j.split("-")[0]) < int(j.split("-")[-1]):
                    for k in range(int(j.split("-")[0]),int(j.split("-")[-1])+1):
                        modelist.append(int(k))
                    #
                else:
                    print("[__main__]: First limit of modelist range has to be SMALLER than second, exiting...")
                    sys.exit(1)
                #
            else:
                print("[__main__]: I don't understand which phonon modes you want to have put out, exiting...")
                sys.exit(1)
            #
        #
        modelist.sort()
        args.modelist = array(list(dict.fromkeys(modelist)))
        #
        eigvals, eigvecs, norms, qpoint, basis, nat, elements, positions, masses, = parsePhonopy(args.modelist, None)
    #
    # symmetry analysis and mode removal
    if args.no_symmetry == False:
        coord = empty((nat, 3))
        for atom in range(nat):
            coord[atom, :] = dot(inv(basis.T), positions[atom, :])
        #
        dataset = get_symmetry_dataset((basis, coord, [periodTable[element] for element in elements]), symprec=1.e-5)
        pointgroup = dataset["pointgroup"]
        modelist = removeModes(eigvecs, eigvals, masses, args.modelist, basis, coord, elements, pointgroup, prec=1e0)
        args.modelist = modelist
    #
    print("[__main__]: Calculating modes "+ str(args.modelist))
    #
    ###################################

    if args.displace == True:
        print("[__main__]: Displacing modes")
        displace(args.modelist, args.stepsize, args.program, disps, args.QEinputfile)
        sys.exit(1)
    
    if args.tensors == True:
        print("[__main__]: Calculating Raman tensors")
        calcTensors(args.modelist, args.program, args.stepsize, disps)

    if args.spectrum == True:
        print("[__main__]: Calculating Raman spectrum")
        calcSpectrum(args.modelist, args.program, args.laser, args.temperature, args.smearing, args.porto, args.qdir, args.LOcorr) 
    
    if args.plot == True:
        print("[__main__]: Plotting Raman spectrum", args.porto)
        plotSpectrum(args.modelist, args.laser, args.porto)

    if args.infrared == True:
        print("[__main__]: Calculating IR spectrum")
        calcIR(args.modelist, args.program, args.smearing)
        
    sys.exit(1)
#
