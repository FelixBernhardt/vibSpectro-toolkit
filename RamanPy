#!/usr/bin/env python

#
# command line interface for the Phonon class API 
#

import sys
import datetime
import numpy as np
from RamanPy_API import Phonon
from parserArgs import args

sys.dont_write_bytecode = True

if __name__ == '__main__':

    print("")
    print("  _____                             _____       ")     
    print(" |  __ \                           |  __ \      ")     
    print(" | |__) |__ _ _ __ ___   __ _ _ __ | |__) |   _ ")
    print(" |  _  // _` | '_ ` _ \ / _` | '_ \|  ___/ | | |")
    print(" | | \ \ (_| | | | | | | (_| | | | | |   | |_| |")
    print(" |_|  \_\__,_|_| |_| |_|\__,_|_| |_|_|    \__, |")
    print("                                           __/ |")
    print("                                          |___/ ")
    print("")
    print("")
    print("    Started at: "+datetime.datetime.now().strftime("%Y-%m-%d %H:%M"))
    print("")
    
    #
    version = "0.0.1"
    disps = [-1, 1]
    
    ###################################
    #
    # setup which modes to calculate
    if args.modelist == None :
        pass
    else:
        # check the modes
        modelist = []
        for j in args.modelist.split():
            if j.isdigit() == True:
                modelist.append(int(j))
            elif j.split("-")[0].isdigit() == True and j.split("-")[-1].isdigit() == True:
                if int(j.split("-")[0]) < int(j.split("-")[-1]):
                    for k in range(int(j.split("-")[0]),int(j.split("-")[-1])+1):
                        modelist.append(int(k))
                    #
                else:
                    print("[__main__]: First limit of modelist range has to be SMALLER than second, exiting...")
                    sys.exit(1)
                #
            else:
                print("[__main__]: I don't understand which phonon modes you want to have put out, exiting...")
                sys.exit(1)
            #
        #
        modelist.sort()
        args.modelist = np.array(list(dict.fromkeys(modelist)))
        #
    #
    ###################################

    if args.version == True:
        print("[__main__]: Version "+version)
        sys.exit(1)

    ###################################
    # checks
    ###################################
    if args.antistokes == True:
        args.stokes = False
    #
    if args.infrared == True or args.LOcorr == True:
        born = True
    else:
        born = False
    #

    # setup the Phonon object
    ph = Phonon(
        path = args.path,
        file = args.file, 
        code_out = args.code_out, 
        modelist = args.modelist,
        nosym = args.no_symmetry,
        stepsize = args.stepsize,
        smearing = args.smearing,
        temperature = args.temperature,
        photon_freq= args.photon,
        stokes = args.stokes,
        born = born,
        qdir = args.qdir,
        LOcorr = args.LOcorr )

    if args.analysis == True and args.symmetry == True:
        print("[__main__]: Analyzing symmetries")
        ph.print_ramantensors()
        ph.print_dielectrictensor()
        ph.print_ramanselection()
        ph.print_irselection()
        sys.exit(1)

    #########
    # IR
    if args.infrared == True:
        print("[__main__]: Calculating IR spectrum")
        ph.IR()

    if args.plotIR == True:
        print("[__main__]: Plotting IR spectrum")
        ph.plot_IR(lualatex=args.lualatex)
    
    # IR Reflectance
    if args.reflectance == True:
        print("[__main__]: Calculating Reflectance")
        ph.reflectance()

    if args.plotReflectance == True:
        print("[__main__]: Plotting Reflectance")
        ph.plot_reflectance(lualatex=args.lualatex)

    # avoid combinations of IR and Raman processing in a single command
    if args.infrared == True or args.plotIR == True or args.reflectance == True or args.plotReflectance == True:
        sys.exit(1)
    #
    ###########

    # LO not implemented
    if ph.LOcorr == True:
        print("[__main__]: LO correction not implemented, please switch off, exiting...")
        sys.exit(1)

    ###########
    # Raman
    print("[__main__]: Calculating Raman modes "+str(ph.modelist))

    if args.displace == True:
        print("[__main__]: Displacing modes")
        ph.displace(args.QEinputfile)
        sys.exit(1)
    
    if args.tensors == True:
        print("[__main__]: Calculating Raman tensors")
        ph.tensors()

    if args.spectrum == True:
        print("[__main__]: Calculating Raman spectrum")
        ph.spectrum() 
    
    if args.plotRaman == True:
        print("[__main__]: Plotting Raman spectrum", args.porto)
        if args.porto == "":
            ph.plot_Raman(lualatex=args.lualatex)
        else:
            ph.plot_Raman(porto=args.porto, lualatex=args.lualatex)
        #
        
    sys.exit(1)
#
