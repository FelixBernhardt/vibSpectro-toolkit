#!/usr/bin/env python

#
# generate cells along eigenmodes
# (run calculations separately for all cells)
# read in data from phonopy
# calculate resonant Raman intensity for various modes
# i.e. two dielectric functions per mode
#

import sys

import datetime

from numpy import arange
from symmetries import analysis
from parserPhonopy import parsePhonopy
from displace import displace
from calcTensors import calcTensors
from calcSpectrum import calcSpectrum
from plotSpectrum import plotSpectrum
from IR import calcIR

sys.dont_write_bytecode = True

if __name__ == '__main__':

    print("")
    print("  _____                             _____       ")     
    print(" |  __ \                           |  __ \      ")     
    print(" | |__) |__ _ _ __ ___   __ _ _ __ | |__) |   _ ")
    print(" |  _  // _` | '_ ` _ \ / _` | '_ \|  ___/ | | |")
    print(" | | \ \ (_| | | | | | | (_| | | | | |   | |_| |")
    print(" |_|  \_\__,_|_| |_| |_|\__,_|_| |_|_|    \__, |")
    print("                                           __/ |")
    print("                                          |___/ ")
    print("")
    print("")
    #print("    Contributors: Felix Bernhardt  (JLU)")
    print("    Started at: "+datetime.datetime.now().strftime("%Y-%m-%d %H:%M"))
    print("")
    
    #
    from parserArgs import args
    disps = [-1, 1]
    version = "0.0.1"

    if args.version == True:
        print("[__main__]: Version "+version)
        sys.exit(1)

    # calc all modes if none are specified
    if args.modelist.size < 1 :
        eigvals, eigvecs, norms, qpoint, basis, nat, elements, positions, masses = parsePhonopy(None, None)
        args.modelist = arange(1, 3*nat+1, 1)
    #

    if args.analysis == True:
        print("[__main__]: Analyzing symmetries")
        analysis(args.modelist)
        sys.exit(1)

    if args.displace == True:
        print("[__main__]: Displacing modes")
        displace(args.modelist, args.stepsize, args.program, disps, args.QEinputfile)
        sys.exit(1)
    
    if args.tensors == True:
        print("[__main__]: Calculating Raman tensors")
        calcTensors(args.modelist, args.program, args.stepsize, disps)

    if args.spectrum == True:
        print("[__main__]: Calculating Raman spectrum")
        calcSpectrum(args.modelist, args.program, args.laser, args.temperature, args.smearing, args.porto, args.qdir, args.LOcorr) 
    
    if args.plot == True:
        print("[__main__]: Plotting Raman spectrum", args.porto)
        plotSpectrum(args.modelist, args.laser, args.porto)

    if args.infrared == True:
        print("[__main__]: Calculating IR spectrum")
        calcIR(args.modelist, args.program, args.smearing)
        
    sys.exit(1)
