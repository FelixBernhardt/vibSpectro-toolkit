    #
    stepSize = 0.01 # Hardcoded, should be fine for almost all systems, also hardcoded in calc_raman
    disps = [-1, 1]

    from parserArgs import args

    if args.displace == True:
        print("[__main__]: Displacing modes " + str(args.modeList))
        displace(args.modeList, disps, stepSize, args.programIN, args.programOUT)
        sys.exit(1)
    
    if args.tensors == True:
        print("[__main__]: Calculating Raman tensors of modes " + str(args.modeList))
        calcTensors(args.modeList, args.programIN, args.programOUT)

    if args.spectrum == True:
        print("[__main__]: Calculating Raman spectrum")
        calcSpectrum(args.modeList, args.w0, args.temp, args.smear) 
    
    if args.plot == True:
        print("[__main__]: Plotting Raman spectrum")
        plotSpectrum(args.w0, args.porto)
        
    sys.exit(1)
