SYSTEM = Pentacene molecule

# Optic
LOPTICS = .TRUE.  # calculate the frequency dependet dielectric function as a function of photon energy
NBANDS = 288      # number of bands to consider for optical transitions, check for convergence, e.g. 4*(NBANDS from phonon calc)
NEDOS = 2000      # large number of sampling points for dielectric function


# Electronic
PREC = Accurate
ENCUT = 520
EDIFF = 1E-8         # very small EDIFF for high accuracy of dielectric function
ALGO = Normal
LREAL = .FALSE.      # important for all calculations

ISMEAR = 0           # Gaussian smearing for Raman
SIGMA = 0.05

LWAVE = .FALSE.
LCHARG = .FALSE.

# No Ionic relaxation
NSW = 0

# Symmetry
ISYM = 0             # we break the symmetry by the phononic displacements

# Dipole correction (IMPORTANT for isolated systems)
#LDIPOL = .TRUE.
#IDIPOL = 3           # z-direction (assuming molecule lies in xy plane)
#DIPOL = 10 10 10     # center of your box (matches POSCAR)

# Optional (recommended for organics)
IVDW = 12            # D3 dispersion correction

# parallelization
KPAR = 1       # we run on one Node, also we only have one K-point
NCORE = 12     # we have 24 cores per Node, 12 is a good value