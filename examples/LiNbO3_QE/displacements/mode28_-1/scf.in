&CONTROL
restart_mode = 'from_scratch' ! start from scratch
pseudo_dir = './',
outdir = 'out',
prefix = 'pwscf'
calculation = 'scf'           ! scf calculation (set 'nscf' for nscf run)
/
&SYSTEM
ibrav = 0,
nat = 10,
ntyp = 3,
ecutwfc = 100,
ecutrho = 1200,
nbnd = 60                    ! check bands for convergence
nosym = .true.
noinv = .true.
/
&ELECTRONS
conv_thr = 1.d-10             ! low value for accurate eigenvalues
/
&IONS
/
&CELL
/
K_POINTS (automatic)
6 6 6 0 0 0
ATOMIC_SPECIES
Li  6.941 Li.upf
Nb 92.906  Nb.upf
O 16.00 O.upf
